# ── Step 2: Fetch company info + earnings date ────────────────
def get_earnings_info(ticker):
    """Returns next earnings date and days until it."""
    try:
        stock = yf.Ticker(ticker)
        cal = stock.calendar
        if cal is not None and not cal.empty:
            # yfinance returns earnings date differently by version
            if "Earnings Date" in cal.index:
                earn_date = cal.loc["Earnings Date"].iloc[0]
            elif hasattr(cal, "columns") and "Earnings Date" in cal.columns:
                earn_date = cal["Earnings Date"].iloc[0]
            else:
                return None, None

            if hasattr(earn_date, 'date'):
                earn_date = earn_date.date()
            today = datetime.today().date()
            days_until = (earn_date - today).days
            return earn_date, days_until
    except Exception:
        pass
    return None, None

# ── Step 3: Fetch news headlines via Alpha Vantage ────────────
def get_news_sentiment(ticker):
    """Fetches latest 5 news headlines and scores sentiment."""
    url = (
        f"https://www.alphavantage.co/query"
        f"?function=NEWS_SENTIMENT&tickers={ticker}"
        f"&limit=5&apikey={YOUR_API_KEY}"
    )
    try:
        r = requests.get(url, timeout=10)
        data = r.json()
        items = data.get("feed", [])
        results = []
        for item in items[:5]:
            title = item.get("title", "")
            published = item.get("time_published", "")[:8]  # YYYYMMDD
            # Format date nicely
            try:
                pub_dt = datetime.strptime(published, "%Y%m%d").strftime("%b %d")
            except Exception:
                pub_dt = published

            # Alpha Vantage gives its own score; we also run TextBlob as backup
            av_score = None
            for ts in item.get("ticker_sentiment", []):
                if ts.get("ticker") == ticker:
                    av_score = float(ts.get("ticker_sentiment_score", 0))
                    break

            if av_score is not None:
                score = av_score
            else:
                score = TextBlob(title).sentiment.polarity

            if score > 0.15:
                sentiment = "🟢 Positive"
            elif score < -0.15:
                sentiment = "🔴 Negative"
            else:
                sentiment = "⚪ Neutral"

            results.append({
                "date": pub_dt,
                "title": title[:90] + ("…" if len(title) > 90 else ""),
                "sentiment": sentiment,
                "score": round(score, 3)
            })
        return results
    except Exception as e:
        return [{"date": "—", "title": f"Could not fetch news ({e})", "sentiment": "—", "score": 0}]

# ── Step 4: Get current price + basic info ───────────────────
def get_price_info(ticker):
    """Returns current price, 52-week range, P/E ratio."""
    try:
        stock = yf.Ticker(ticker)
        info = stock.info
        price   = info.get("currentPrice") or info.get("regularMarketPrice", "N/A")
        pe      = info.get("trailingPE", "N/A")
        low52   = info.get("fiftyTwoWeekLow", "N/A")
        high52  = info.get("fiftyTwoWeekHigh", "N/A")
        name    = info.get("shortName", ticker)
        sector  = info.get("sector", "—")
        return {
            "name": name,
            "price": f"${price:.2f}" if isinstance(price, (int, float)) else str(price),
            "pe":    f"{pe:.1f}x"    if isinstance(pe,    (int, float)) else str(pe),
            "52wk": f"${low52:.2f} – ${high52:.2f}"
                    if isinstance(low52, (int, float)) else "N/A",
            "sector": sector,
        }
    except Exception:
        return {"name": ticker, "price": "N/A", "pe": "N/A", "52wk": "N/A", "sector": "N/A"}

# ── Step 5: Earnings alert logic ─────────────────────────────
def earnings_alert(ticker, days_until, earn_date):
    if days_until is None:
        return ""
    if days_until < 0:
        return f"  📅 Earnings were {abs(days_until)} days ago ({earn_date})\n"
    if days_until == 0:
        return f"  🚨 EARNINGS TODAY! ({earn_date}) — stay alert!\n"
    if days_until <= ALERT_DAYS_BEFORE_EARNINGS:
        return f"  ⚠️  EARNINGS IN {days_until} DAY(S) — {earn_date} — consider your position!\n"
    return f"  📅 Next earnings: {earn_date} (in {days_until} days)\n"

# ── Step 6: Run the full scan ────────────────────────────────
def run_scan():
    print("=" * 65)
    print(f"  📊 TRADING BOT — PHASE 1 DAILY SCAN")
    print(f"  {datetime.now().strftime('%A, %B %d %Y  %H:%M')}")
    print("=" * 65)

    for ticker in YOUR_WATCHLIST:
        print(f"\n{'─'*65}")
        print(f"  🔍 {ticker}")
        print(f"{'─'*65}")

        # Price + basics
        info = get_price_info(ticker)
        print(f"  Company : {info['name']}  |  Sector: {info['sector']}")
        print(f"  Price   : {info['price']}  |  P/E: {info['pe']}  |  52-wk: {info['52wk']}")

        # Earnings
        earn_date, days_until = get_earnings_info(ticker)
        alert_msg = earnings_alert(ticker, days_until, earn_date)
        if alert_msg:
            print(alert_msg, end="")

        # News + sentiment
        print(f"\n  Latest news:")
        headlines = get_news_sentiment(ticker)
        for h in headlines:
            print(f"    [{h['date']}] {h['sentiment']}  {h['title']}")

    print(f"\n{'='*65}")
    print("  ✅ Scan complete. Check any ⚠️  or 🚨 alerts above.")
    print(f"  ℹ️  This is research only — not financial advice.")
    print("=" * 65)

# ── RUN IT ───────────────────────────────────────────────────
run_scan()
